# Chart Scanner AI (OpenAI-compatible OpenAPI)
# Put your key HERE — never commit the real .env file
CHART_SCAN_API_KEY=sk-your-openai-or-openapi-key
# Optional overrides:
# OPENAI_API_KEY=sk-...          # also accepted
# CHART_SCAN_API_URL=https://api.openai.com/v1/chat/completions
# CHART_SCAN_MODEL=gpt-4o

# MT5 REST API
# MT5_API_BASE=http://66.23.225.158

# Vercel production database (GitHub-backed)
# Create a classic PAT with `repo` scope and set it in Vercel → Project → Settings → Environment Variables
# Name: LUMO_DATA_TOKEN
# This lets registrations, mentor signups, and "I've Paid" sync for Super Admin on lumoedge.com
# LUMO_DATA_TOKEN=ghp_xxxxxxxx
# LUMO_DATA_OWNER=mukundimukhuba8-jpg
# LUMO_DATA_REPO=lumoedge
# LUMO_DATA_PATH=cloud-data/db.json
