# Chart Scanner AI (OpenAI-compatible OpenAPI)
# Put your key HERE locally — and on Vercel → Settings → Environment Variables
# for Production (then Redeploy). Never commit the real .env file.
# Do NOT store this key in Firebase (current /lumo rules are public-read).
CHART_SCAN_API_KEY=sk-your-openai-or-openapi-key
# Optional overrides:
# OPENAI_API_KEY=sk-...          # also accepted
# CHART_SCAN_API_URL=https://api.openai.com/v1/chat/completions
# CHART_SCAN_MODEL=gpt-4o

# Resend transactional email (server / Cloud Functions ONLY — never VITE_*)
# Vercel → Environment Variables → RESEND_API_KEY (then Redeploy)
# Firebase → firebase functions:secrets:set RESEND_API_KEY
RESEND_API_KEY=re_xxxxxxxx
# Until lumoedge.com is verified in Resend, use onboarding@resend.dev
# EMAIL_FROM=Lumo Edge <onboarding@resend.dev>
# After domain verify: EMAIL_FROM=Lumo Edge <noreply@lumoedge.com>
EMAIL_REPLY_TO=lumoedge08@gmail.com

# MT5 REST API (Swagger: https://66.23.225.158/swagger/index.html)
# Use the host only — no /swagger path:
# MT5_API_BASE=https://66.23.225.158
# MT5_API_HOST=66.23.225.158

# Firebase (Realtime Database + Storage) — durable backend for lumoedge.com
# Web config is public; protect data with Firebase Console security rules.
# Defaults are already baked into the app for project lumoedge-61c02.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_DATABASE_URL=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=

# Optional legacy GitHub-backed API (fallback only)
# LUMO_DATA_TOKEN=ghp_xxxxxxxx
# LUMO_DATA_OWNER=mukundimukhuba8-jpg
# LUMO_DATA_REPO=lumoedge
# LUMO_DATA_PATH=cloud-data/db.json
